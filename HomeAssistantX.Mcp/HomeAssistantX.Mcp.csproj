<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HomeAssistantX\HomeAssistantX.csproj" />
    <InternalsVisibleTo Include="HomeAssistantX.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>homeassistantx-mcp</ToolCommandName>
    <PackageId>HomeAssistantX.Mcp</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>Local MCP server for Home Assistant discovery, diagnostics, and automation authoring through HomeAssistantX.</Description>
    <Authors>Przemyslaw Klys</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/EvotecIT/HomeAssistantX</PackageProjectUrl>
    <RepositoryUrl>https://github.com/EvotecIT/HomeAssistantX</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
