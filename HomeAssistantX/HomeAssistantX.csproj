<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;netstandard2.0;net10.0</TargetFrameworks>
    <AssemblyName>HomeAssistantX</AssemblyName>
    <RootNamespace>HomeAssistantX</RootNamespace>
    <Description>A modern, typed, event-driven .NET client for the Home Assistant REST and WebSocket APIs.</Description>
    <VersionPrefix>0.1.0</VersionPrefix>
    <PackageId>HomeAssistantX</PackageId>
    <Authors>Przemyslaw Klys</Authors>
    <Company>Evotec</Company>
    <Copyright>(c) 2026 Evotec. All rights reserved.</Copyright>
    <PackageTags>home-assistant;smart-home;rest;websocket;automation;net472;netstandard2.0;net10.0</PackageTags>
    <PackageProjectUrl>https://github.com/EvotecIT/HomeAssistantX</PackageProjectUrl>
    <RepositoryUrl>https://github.com/EvotecIT/HomeAssistantX</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IsPackable>true</IsPackable>
    <IsPublishable>true</IsPublishable>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472' Or '$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.11" />
    <PackageReference Include="System.Threading.Channels" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="README.md" />
    <InternalsVisibleTo Include="HomeAssistantX.Tests" />
    <InternalsVisibleTo Include="HomeAssistantX.PowerShell" />
  </ItemGroup>
</Project>
