{
  "$schema": "https://raw.githubusercontent.com/EvotecIT/PSPublishModule/main/Schemas/project.build.schema.json",
  "RootPath": "..",
  "ExpectedVersion": "0.1.X",
  "ExpectedVersionMapAsInclude": false,
  "AlignPackageVersions": true,
  "ExcludeProjects": [
    "HomeAssistantX.Tests",
    "HomeAssistantX.LiveTests",
    "HomeAssistantX.TestServer",
    "HomeAssistantX.Console"
  ],
  "IncludePrerelease": false,
  "Configuration": "Release",
  "StagingPath": "Artefacts/ProjectBuild",
  "CleanStaging": true,
  "UpdateVersions": true,
  "Build": true,
  "PackStrategy": "PerProject",
  "PublishNuget": false,
  "PublishGitHub": false,
  "CreateReleaseZip": true,
  "CertificateStore": "CurrentUser",
  "TimeStampServer": "http://timestamp.digicert.com",
  "PublishSource": "https://api.nuget.org/v3/index.json",
  "SkipDuplicate": true,
  "PublishFailFast": true,
  "GitHubUsername": "EvotecIT",
  "GitHubRepositoryName": "HomeAssistantX",
  "GitHubIsPreRelease": false,
  "GitHubIncludeProjectNameInTag": false,
  "GitHubGenerateReleaseNotes": true,
  "GitHubReleaseMode": "Single",
  "GitHubPrimaryProject": "HomeAssistantX",
  "GitHubTagTemplate": "v{Version}",
  "GitHubReleaseName": "HomeAssistantX {Version}"
}
